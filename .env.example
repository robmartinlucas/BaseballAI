# Copy this file to .env and fill in the values locally.
# Never commit the real .env file, OAuth tokens, or Yahoo client secret.

YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Add this exact URL to the Yahoo Developer app's Redirect URI list.
YAHOO_REDIRECT_URI=https://localhost:5050/oauth/callback

# Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

WEB_HOST=127.0.0.1
WEB_PORT=5050
WEB_HTTPS=1

# Local token cache. The instance/ directory is gitignored.
YAHOO_TOKEN_FILE=instance/yahoo_tokens.json
